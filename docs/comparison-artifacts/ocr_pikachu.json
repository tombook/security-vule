    {
      "path": "sqli_sqli_widebyte.php",
      "content": "\u67e5\u8be2\u7ed3\u679c\u4e2d\u7684 `$id` \u548c `$email` \u76f4\u63a5\u62fc\u63a5\u5230HTML\u4e2d\u8f93\u51fa\uff0c\u672a\u7ecf\u8fc7 `htmlspecialchars()` \u7b49\u8f6c\u4e49\u5904\u7406\u3002\u5982\u679c\u6570\u636e\u5e93\u4e2d\u5b58\u50a8\u4e86\u6076\u610f\u811a\u672c\u5185\u5bb9\uff08\u5982 `<script>alert(1)</script>`\uff09\uff0c\u5c06\u5bfc\u81f4\u5b58\u50a8\u578bXSS\u6f0f\u6d1e\u3002\n\n\u5bf9\u4e8e\u5b89\u5168\u9776\u573a\u9879\u76ee\uff0c\u5982\u679c\u8fd9\u662f\u6545\u610f\u8bbe\u8ba1\u7684\u6f0f\u6d1e\u6f14\u793a\u5219\u53ef\u4ee5\u4fdd\u7559\uff1b\u4f46\u5efa\u8bae\u81f3\u5c11\u6dfb\u52a0\u6ce8\u91ca\u8bf4\u660e\u6b64\u5904\u6545\u610f\u672a\u505aXSS\u9632\u62a4\u3002\n\n\u5b89\u5168\u505a\u6cd5\uff1a`$id=htmlspecialchars($data['id'], ENT_QUOTES, 'UTF-8');`",
      "suggestion_code": "        while ($data=mysqli_fetch_assoc($result)){\n            $id=htmlspecialchars($data['id'], ENT_QUOTES, 'UTF-8');\n            $email=htmlspecialchars($data['email'], ENT_QUOTES, 'UTF-8');\n            $html.=\"<p class='notice'>your uid:{$id} <br />your email is: {$email}</p>\";",
      "existing_code": "        while ($data=mysqli_fetch_assoc($result)){\n            $id=$data['id'];\n            $email=$data['email'];\n            $html.=\"<p class='notice'>your uid:{$id} <br />your email is: {$email}</p>\";",
