{
  "name": "security-vule",
  "version": "0.2.0",
  "description": "MSSP whitebox vulnerability mining + AI-assisted PoC verification platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres adminer",
    "db:down": "docker compose down",
    "db:migrate": "for f in db/migrations/*.sql; do PGPASSWORD=dev_password psql -h localhost -U security_vule -d security_vule -f \"$f\" || break; done",
    "db:reset": "docker compose down -v && docker compose up -d postgres adminer && sleep 5 && bun run db:migrate",
    "api:dev": "cd apps/api && bun run dev",
    "web:dev": "cd apps/web && bun run dev",
    "api:build": "cd apps/api && bun run build",
    "web:build": "cd apps/web && bun run build",
    "test:p0": "bun test tests/integration/multi_tenant_isolation.test.ts",
    "test": "bun test tests/",
    "test:e2e": "playwright test e2e-tests/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@google/generative-ai": "^0.24.1",
    "ollama": "^0.6.3",
    "openai": "^6.42.0",
    "tree-sitter-php": "^0.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.60.0",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "tree-sitter-php"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  }
}
