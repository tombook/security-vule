{
  "name": "security-vule",
  "version": "1.0.0",
  "description": "Data-driven white-box vulnerability mining system",
  "type": "module",
  "scripts": {
    "analyze": "bun --bun src/engine/analyzer.ts",
    "cli": "bun --bun src/integration/cli.ts",
    "vule": "bun --bun src/integration/vule-cli.ts",
    "mcp": "bun --bun src/mcp/server.ts",
    "evolve": "bun --bun src/evolution/evolver.ts",
    "evolve-enhanced": "bun --bun src/evolution/run-evolution-enhanced.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "bench": "bun --bun src/integration/benchmark.ts",
    "benchmark:eval": "bun --bun -e \"import {evaluate,SYNTHETIC_DATASET,formatReport} from './src/benchmark/index.js'; console.log(formatReport(evaluate(SYNTHETIC_DATASET,[])));\"",
    "sbom": "bun --bun -e \"import { spawn } from 'child_process'; const r = spawn('node', ['node_modules/@cyclonedx/cyclonedx-npm/bin/cyclonedx-npm-cli.js', '--output-format', 'JSON', '--output-file', 'sbom.json', '--spec-version', '1.5'], { stdio: 'inherit' }); r.on('exit', (c) => process.exit(c || 0));\"",
    "license:check": "bun x license-checker --production --failOn 'GPL;AGPL-UNKNOWN;UNKNOWN;WTFPL'",
    "license:summary": "bun x license-checker --production --json | bun --bun -e \"process.stdin.on('data', d => { const r = JSON.parse(d.toString()); const counts = {}; for (const k in r) counts[r[k].licenses] = (counts[r[k].licenses] || 0) + 1; console.log(counts); });\"",
    "docs:api": "bun x typedoc",
    "docs:api:watch": "bun x typedoc --watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "exports": {
    "./plugin": "./src/plugin/index.js",
    "./benchmark": "./src/benchmark/index.js",
    "./mcp": "./src/mcp/server.js",
    "./line-locator": "./src/detection/line-locator.js",
    "./program-graph": "./src/engine/program-graph.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "commander": "^15.0.0",
    "js-yaml": "^4.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.42.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "tree-sitter-php": "^0.24.2"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@types/bun": "^1.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "libxmljs2",
    "tree-sitter-php"
  ]
}
