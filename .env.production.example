# security-vule 生产部署环境变量样例
# 用法: cp .env.production.example .env.production 并填入真实值
# 启动: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ============== 核心 ==============
NODE_ENV=production
LOG_LEVEL=info

# ============== 数据库 (与 docker-compose.prod.yml 中 postgres 服务一致) ==============
POSTGRES_USER=security_vule
POSTGRES_DB=security_vule
POSTGRES_PORT=5433
# 注意: db_password 实际值放在 secrets/db_password.txt
# 这里仅供脚本读取用,真实密码以 docker secret 为准
DATABASE_URL=postgresql://security_vule:CHANGE_ME@postgres:5432/security_vule

# ============== API ==============
PORT=3000
# JWT 实际密钥放在 secrets/jwt_secret.txt
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=https://app.example.com
VITE_API_BASE=https://api.example.com

# ============== SAML SSO (Phase 3A) ==============
# IdP 私钥 PEM 放在 secrets/saml_idp_key.pem
# 公共 SP 元数据 endpoint: GET /api/auth/sso/metadata?tenant_id=...
SAML_WEBHOOK_SECRET=__CHANGE_ME_RANDOM_HEX__

# ============== Stripe (Phase 2D, mock 模式可跳过) ==============
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
# 真实 Stripe webhook secret 放在 secrets/stripe_webhook_secret.txt

# ============== Redis (Phase 1+ 限流/session 缓存) ==============
REDIS_URL=redis://redis:6379

# ============== 部署后必改清单 ==============
# 1. 所有 __CHANGE_ME__ 占位符
# 2. FRONTEND_URL 改为你自己的公网域名
# 3. VITE_API_BASE 改为你自己的 API 公网域名
# 4. STRIPE_MODE 切到 real 时填 STRIPE_SECRET_KEY
# 5. secrets/*.txt 全部 chmod 600
# 6. nginx.conf 的 server_name 与 TLS 证书路径